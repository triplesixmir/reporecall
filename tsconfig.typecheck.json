{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@reporecall/core": ["packages/core/src/index.ts"],
      "@reporecall/storage": ["packages/storage/src/index.ts"],
      "@reporecall/index": ["packages/index/src/index.ts"],
      "@reporecall/context": ["packages/context/src/index.ts"],
      "@reporecall/integrations": ["packages/integrations/src/index.ts"],
      "@reporecall/processors": ["packages/processors/src/index.ts"],
      "@reporecall/mcp": ["packages/mcp/src/index.ts"]
    },
    "rootDir": ".",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["packages/*/src/**/*.ts", "apps/web/src/**/*.ts", "apps/web/src/**/*.tsx"]
}
